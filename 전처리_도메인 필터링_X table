section("4. 검증")

ok = True


def check(cond, msg_ok, msg_fail):
    global ok
    if cond:
        print(f"[통과] {msg_ok}")
    else:
        print(f"[실패] {msg_fail}")
        ok = False


check(len(df) == n_before, f"행 수 유지: {len(df):,}행",
      f"행 수 변동: {n_before:,} -> {len(df):,}")

# 삭제됐어야 할 원본 컬럼 (원-핫으로 대체되거나 파생 후 불필요해진 것)
removed = ["purpose", "home_ownership", "fico_range_low", "fico_range_high"]
leftover = [c for c in removed if c in df.columns]
check(not leftover, f"원본 컬럼 {len(removed)}개 삭제 확인",
      f"삭제되지 않은 원본 컬럼: {leftover}")

# 이름을 유지한 채 인코딩된 변수는 그대로 살아 있어야 한다
kept = ["annual_inc", "term", "dti", "emp_length", "application_type", "loan_amnt"]
missing_kept = [c for c in kept if c not in df.columns]
check(not missing_kept, f"이름 유지 변수 {len(kept)}개 보존 확인",
      f"사라진 변수: {missing_kept}")

# 새로 만든 변수에 결측이 없어야 함
must_filled = ([c for c in CENSUS_COLS + [BANK_COL] if c in df.columns]
               + ["annual_inc", "fico_avg", "dti", "emp_length", "emp_length_missing",
                  "application_type", "income_to_zip3_median", "term"]
               + PURPOSE_COLS + HOME_COLS)
must_filled = [c for c in must_filled if c in df.columns]
na_counts = df[must_filled].isna().sum()
na_bad = na_counts[na_counts > 0]
check(len(na_bad) == 0, "신규/정제 변수 결측 0건", f"결측 잔존:\n{na_bad.to_string()}")

# 원-핫은 행 합이 정확히 1
for name, cols in [("purpose", PURPOSE_COLS), ("home_ownership", HOME_COLS)]:
    cols = [c for c in cols if c in df.columns]
    if cols:
        s = df[cols].sum(axis=1)
        check(bool((s == 1).all()), f"{name} 원-핫 행 합 = 1",
              f"{name} 원-핫 행 합 != 1 인 행 {(s != 1).sum():,}건")

# 값 범위 검증
check(bool(df["dti"].between(0, DTI_CAP).all()), f"dti 범위 0~{DTI_CAP}",
      "dti 가 허용 범위를 벗어남")
check(bool(df["emp_length"].between(0, 10).all()), "emp_length 범위 0~10",
      "emp_length 가 0~10 범위를 벗어남")
check(bool(df["fico_avg"].between(300, 900).all()), "fico_avg 범위 300~900",
      "fico_avg 가 비정상 범위")
check(bool(set(df["term"].unique()) <= {0, 1}), "term 이진값",
      "term 에 0/1 외 값 존재")
check(bool(set(df["application_type"].unique()) <= {0, 1}),
      "application_type 이진값", "application_type 에 0/1 외 값 존재")
# log1p 적용 결과는 합리적 범위(연소득 5~40만 달러 → 대략 1.6~12.9) 안에 있어야 한다
check(bool(df["annual_inc"].between(0, 20).all()), "annual_inc 로그 스케일 범위 정상",
      "annual_inc 가 로그 스케일로 보이지 않음 (변환 누락 의심)")

check(df["id"].is_unique and df["id"].notna().all(), "id 고유·결측 없음", "id 중복 또는 결측")

print("\n[주요 변수 분포]")
show = [c for c in ["annual_inc", "fico_avg", "dti", "emp_length",
                    "income_to_zip3_median"] if c in df.columns]
print(df[show].describe().round(3).to_string())

print("\n[왜도]")
for c in show:
    print(f"  {c:24s}: {df[c].skew():.3f}")


