#   - loan_amnt : 그대로 사용 (결측 0%, 왜도 0.78 → 변환 불필요)
#   - term      : 이진 인코딩 → term_60m (36개월=0, 60개월=1)
#   - purpose   : 14개 목적 원-핫 인코딩 → purpose_* 14개
#
# [입력]  X_table_part1.csv (없으면 X_table_raw.csv)
# [출력]  X_table_part2.csv

# %%
# ─────────────────────────────────────────────────────────
# 0. 설정 및 데이터 로드
# ─────────────────────────────────────────────────────────
import os
import numpy as np
import pandas as pd


def find_data_dir(candidates=("X_table_part1.csv", "X_table_raw.csv"), max_up=5):
    """스크립트 위치에서 상위로 올라가며 데이터 파일이 있는 폴더를 찾는다."""
    try:
        start = os.path.dirname(os.path.abspath(__file__))
    except NameError:          # VS Code 셀(# %%) 실행 시 __file__ 미정의
        start = os.getcwd()

    d = start
    for _ in range(max_up):
        if any(os.path.exists(os.path.join(d, f)) for f in candidates):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    raise FileNotFoundError(
        f"{candidates} 중 아무것도 '{start}' 및 상위 {max_up}단계에서 찾지 못했습니다.\n"
        f'BASE_DIR 을 직접 지정하세요: BASE_DIR = "/Users/.../통계_데이터사이언스_Lending Club 과제"'
    )


BASE_DIR = find_data_dir()

# Part1 산출물이 있으면 이어서, 없으면 원본 X 테이블에서 시작
if os.path.exists(os.path.join(BASE_DIR, "X_table_part1.csv")):
    IN_PATH = os.path.join(BASE_DIR, "X_table_part1.csv")
else:
    IN_PATH = os.path.join(BASE_DIR, "X_table_raw.csv")
    print("[주의] X_table_part1.csv 가 없어 X_table_raw.csv 로 시작합니다.")
    print("       Part1(식별자/메타정보)을 먼저 실행하면 zip3 변수가 함께 유지됩니다.")

OUT_PATH = os.path.join(BASE_DIR, "X_table_part2.csv")

df = pd.read_csv(IN_PATH, dtype={"zip_code": str})
n_before = len(df)
print(f"입력: {os.path.basename(IN_PATH)}  {df.shape[0]:,}행 × {df.shape[1]}열")

# %%
# ─────────────────────────────────────────────────────────
# 1. loan_amnt — 그대로 사용
# ─────────────────────────────────────────────────────────
# 결측 0%, 왜도 0.78 로 정규성 가정에서 크게 벗어나지 않아 변환하지 않는다.
# 500~40,000 달러로 상한이 제도적으로 막혀 있어 극단치 처리도 불필요.
print("[loan_amnt]")
print(df["loan_amnt"].describe().round(1).to_string())
print(f"  결측: {df['loan_amnt'].isna().sum():,}건 | 왜도: {df['loan_amnt'].skew():.3f}")

# %%
# ─────────────────────────────────────────────────────────
# 2. term — 이진 인코딩
# ─────────────────────────────────────────────────────────
# 원본 값이 ' 36 months' 처럼 앞에 공백이 있어 strip 없이 비교하면 매칭되지 않는다.
print("[term] 원본 값:", [repr(v) for v in df["term"].dropna().unique()])

term_clean = df["term"].astype(str).str.strip()

# 숫자만 추출해 개월 수로 변환 (' 36 months' → 36)
term_months = pd.to_numeric(
    term_clean.str.extract(r"(\d+)")[0], errors="coerce"
)

unexpected = set(term_months.dropna().unique()) - {36, 60}
if unexpected:
    raise ValueError(f"예상치 못한 term 값: {unexpected} (36/60 만 있어야 함)")

# 36개월=0, 60개월=1
df["term_60m"] = (term_months == 60).astype("int8")

print(df["term_60m"].value_counts().rename({0: "36개월(0)", 1: "60개월(1)"}).to_string())
print(f"  60개월 비율: {df['term_60m'].mean() * 100:.2f}%")

# %%
# ─────────────────────────────────────────────────────────
# 3. purpose — 14개 원-핫 인코딩
# ─────────────────────────────────────────────────────────
# 기대되는 14개 범주를 명시적으로 고정한다.
# 이렇게 해야 train/val/test 를 따로 인코딩해도 컬럼 구성이 항상 동일하고,
# 나중에 test 에만 없는 범주 때문에 컬럼이 어긋나는 사고를 막을 수 있다.
PURPOSE_CATEGORIES = [
    "debt_consolidation", "credit_card", "home_improvement", "other",
    "major_purchase", "medical", "small_business", "car",
    "vacation", "house", "moving", "wedding",
    "renewable_energy", "educational",
]

purpose_clean = df["purpose"].astype(str).str.strip().str.lower()

print("[purpose] 분포")
vc = purpose_clean.value_counts()
for cat in PURPOSE_CATEGORIES:
    n = int(vc.get(cat, 0))
    print(f"  {cat:20s} {n:>9,}  ({n / len(df) * 100:5.2f}%)")

# 예상 목록에 없는 값이 있는지 확인
unknown = set(vc.index) - set(PURPOSE_CATEGORIES) - {"nan"}
if unknown:
    print(f"  [주의] 사전에 없는 범주 발견: {unknown}")

# Categorical 로 고정한 뒤 get_dummies → 14개 컬럼이 항상 생성됨
purpose_cat = pd.Categorical(purpose_clean, categories=PURPOSE_CATEGORIES)
dummies = pd.get_dummies(purpose_cat, prefix="purpose", dtype="int8")
dummies.index = df.index

df = pd.concat([df, dummies], axis=1)
purpose_cols = list(dummies.columns)
print(f"\n생성된 원-핫 컬럼 {len(purpose_cols)}개")

# %% [markdown]
# **원-핫 시 기준범주(drop_first)를 빼지 않은 이유**
#
# 14개를 모두 유지한다. 트리 계열은 더미 트랩의 영향을 받지 않아 전부 필요하고,
# LASSO 같은 벌점 회귀도 절편이 정규화되지 않는 한 완전 더미 코딩이 표준이다.
# 선형 모델에서 완전공선성이 문제가 되면 그때 한 컬럼만 빼면 되므로,
# 정보를 남겨두는 쪽이 안전하다.
#
# **희소 범주 주의**
#
# educational(0.01%), renewable_energy(0.06%), wedding(0.08%)은 표본이 매우 적다.
# 6:2:2 분할 후 val/test 에는 educational 이 수십 건만 남을 수 있어
# 해당 더미의 계수/중요도는 해석하지 않는 편이 낫다.
# 성능이 나오지 않으면 이 3개를 other 로 통합하는 방안을 검토한다.

# %%
# ─────────────────────────────────────────────────────────
# 4. 원본 문자열 컬럼 제거
# ─────────────────────────────────────────────────────────
df = df.drop(columns=["term", "purpose"])
print("원본 term, purpose 컬럼 제거 완료")

# %%
# ─────────────────────────────────────────────────────────
# 5. 검증
# ─────────────────────────────────────────────────────────
new_cols = ["term_60m"] + purpose_cols
ok = True

# 행 수 보존
if len(df) != n_before:
    print(f"[실패] 행 수 변동: {n_before:,} -> {len(df):,}")
    ok = False
else:
    print(f"[통과] 행 수 유지: {len(df):,}행")

# 신규 컬럼 결측 없음
na = int(df[new_cols].isna().sum().sum())
if na:
    print(f"[실패] 신규 컬럼 결측 {na}건")
    ok = False
else:
    print("[통과] 신규 컬럼 결측 0건")

# 원-핫 행 합이 정확히 1 (범주가 하나만 켜져야 정상)
row_sum = df[purpose_cols].sum(axis=1)
bad = int((row_sum != 1).sum())
if bad:
    print(f"[실패] 원-핫 행 합이 1이 아닌 행 {bad:,}건 "
          f"(0이면 미분류 범주, 2 이상이면 중복 인코딩)")
    ok = False
else:
    print("[통과] 원-핫 행 합 = 1 (모든 행이 정확히 한 범주)")

# 인코딩 전후 범주별 건수 일치
mismatch = [c for c in purpose_cols
            if int(df[c].sum()) != int(vc.get(c.replace("purpose_", ""), 0))]
if mismatch:
    print(f"[실패] 인코딩 전후 건수 불일치: {mismatch}")
    ok = False
else:
    print("[통과] 인코딩 전후 범주별 건수 일치")

# term 검산: 원본 문자열과 교차 확인
if term_months.isna().sum():
    print(f"[실패] term 변환 실패 {term_months.isna().sum():,}건")
    ok = False
else:
    print("[통과] term 전건 변환 성공")

# 원본 컬럼이 남아있지 않은지
leftover = [c for c in ("term", "purpose") if c in df.columns]
if leftover:
    print(f"[실패] 원본 컬럼이 남아 있음: {leftover}")
    ok = False
else:
    print("[통과] 원본 문자열 컬럼 제거 확인")

print(f"\n검증 결과: {'전체 통과' if ok else '실패 항목 있음 — 위 로그 확인'}")

# %%
# ─────────────────────────────────────────────────────────
# 6. 저장
# ─────────────────────────────────────────────────────────
df.to_csv(OUT_PATH, index=False)
print(f"출력: {df.shape[0]:,}행 × {df.shape[1]}열")
print(f"추가 컬럼 {len(new_cols)}개 (term_60m 1 + purpose 14)")
print(f"제거 컬럼 2개 (term, purpose)")
print(f"저장: {OUT_PATH}")

# %% 3번 대출자 특성
"""
Part 3) 차주 신용 프로필 정제  (+ Part 1·2 결과 통합 반영)

[동작 방식]
  X_table_raw.csv 하나를 계속 갱신하는 방식. 새 파일을 만들지 않는다.
  이미 적용된 단계는 자동으로 건너뛰므로 여러 번 실행해도 안전하다(멱등).

    1) Part 1 식별자/메타정보  — zip3 외부변수
    2) Part 2 대출 자체 조건    — term, purpose
    3) Part 3 차주 신용 프로필  — 아래 6개

[변수명 원칙]
  기존 변수를 정제·인코딩한 결과는 원래 이름을 그대로 유지한다.
  (annual_inc, term, dti, emp_length, application_type)
  원-핫처럼 한 변수가 여러 컬럼이 되는 경우만 원래 이름을 접두어로 쓴다.
  (purpose_*, home_ownership_*)
  원본에 없던 새 정보만 새 이름을 갖는다. (fico_avg, zip3_*, income_to_zip3_median)

[Part 3 처리 내역]
  1. annual_inc        하한 결측화 → 상위 윈저라이징 → log1p (제자리 적용)
  2. fico_avg          fico_range_low·high 평균 (원본 2개 삭제)
  3. dti               999 센티넬 제거 → 상한 클리핑 → 중앙값 대체
  4. emp_length        순서형 0~10 인코딩 + 무직 더미 emp_length_missing
  5. home_ownership    희소범주 통합 후 원-핫 home_ownership_*
  6. application_type  이진 변환 (Individual=0 / Joint=1)

[입력/출력]
  X_table_raw.csv          ← 읽고, 갱신해서 같은 자리에 덮어씀
  X_derived_variables.csv  ← 새로 만들어진 파생변수만 따로 저장(확인용)
  X_table_raw.backup.csv   ← 최초 1회만 생성되는 원본 백업
"""

import os
import shutil
import numpy as np
import pandas as pd

# ─────────────────────────────────────────────────────────
# 설정
# ─────────────────────────────────────────────────────────
ANNUAL_INC_CLIP_Q = 0.995   # 연소득 윈저라이징 분위수 (0.995 → 상위 0.5% 절단)
ANNUAL_INC_FLOOR  = 0       # 이 값 이하의 연소득은 입력 오류로 보고 결측 처리
DTI_SENTINEL      = 999     # 이 값 이상은 결측 코드로 간주
DTI_CAP           = 100     # 센티넬 제거 후 적용할 상한
MAKE_BACKUP       = True    # 최초 1회 원본 백업 (약 1.2GB 디스크 사용)

# purpose 중 단독 유지할 범주.
# 기준: 'other'(106,217건)보다 건수가 적은 범주는 모두 other 로 통합한다.
# 전체 데이터 기준 major_purchase 이하 10개 범주가 여기에 해당한다.
PURPOSE_KEEP = ["debt_consolidation", "credit_card", "home_improvement", "other"]
PURPOSE_FALLBACK = "other"

# home_ownership 중 단독 유지할 범주. ANY/NONE/OTHER 는 OTHER 로 통합.
HOME_KEEP = ["MORTGAGE", "RENT", "OWN", "OTHER"]
HOME_FALLBACK = "OTHER"


def find_data_dir(filename="X_table_raw.csv", max_up=5):
    """스크립트 위치에서 상위로 올라가며 데이터 폴더를 찾는다."""
    try:
        start = os.path.dirname(os.path.abspath(__file__))
    except NameError:
        start = os.getcwd()
    d = start
    for _ in range(max_up):
        if os.path.exists(os.path.join(d, filename)):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    raise FileNotFoundError(
        f"'{filename}' 을 '{start}' 및 상위 {max_up}단계에서 찾지 못했습니다.\n"
        f'BASE_DIR 을 직접 지정하세요: BASE_DIR = "/Users/.../통계_데이터사이언스_Lending Club 과제"'
    )


def section(t):
    print("\n" + "=" * 62)
    print(t)
    print("=" * 62, flush=True)


BASE_DIR     = find_data_dir()
RAW_PATH     = os.path.join(BASE_DIR, "X_table_raw.csv")
TMP_PATH     = os.path.join(BASE_DIR, "X_table_raw.csv.tmp")
BACKUP_PATH  = os.path.join(BASE_DIR, "X_table_raw.backup.csv")
DERIVED_PATH = os.path.join(BASE_DIR, "X_derived_variables.csv")
CENSUS_CACHE = os.path.join(BASE_DIR, "census_zip3_2016.csv")
FDIC_CACHE   = os.path.join(BASE_DIR, "fdic_zip3_2007.csv")

PURPOSE_COLS = [f"purpose_{c}" for c in PURPOSE_KEEP]
HOME_COLS    = [f"home_ownership_{c}" for c in HOME_KEEP]


# ─────────────────────────────────────────────────────────
# 0. 로드 + 백업
# ─────────────────────────────────────────────────────────
section("0. X_table_raw.csv 로드")

if MAKE_BACKUP and not os.path.exists(BACKUP_PATH):
    print("원본 백업 생성 중... (최초 1회)")
    shutil.copy2(RAW_PATH, BACKUP_PATH)
    print(f"  → {os.path.basename(BACKUP_PATH)}")

df = pd.read_csv(RAW_PATH, dtype={"zip_code": str}, low_memory=False)
n_before = len(df)
cols_before = set(df.columns)
print(f"입력: {df.shape[0]:,}행 × {df.shape[1]}열")

# 어느 단계까지 적용됐는지 감지 (여러 번 실행해도 중복 적용되지 않도록)
# term/emp_length 등은 이름이 그대로라 판별 기준이 될 수 없으므로
# 각 단계에서만 생기는 고유 컬럼으로 확인한다.
done_p1 = "zip3_median_income" in df.columns
done_p2 = "purpose_debt_consolidation" in df.columns
done_p3 = "fico_avg" in df.columns
print(f"기적용 상태 → Part1: {done_p1} | Part2: {done_p2} | Part3: {done_p3}")


# ─────────────────────────────────────────────────────────
# 1. Part 1 — 식별자/메타정보
# ─────────────────────────────────────────────────────────
section("1. Part 1 — 식별자/메타정보")

CENSUS_COLS = ["zip3_median_income", "zip3_median_home_value", "zip3_no_earnings_ratio"]
BANK_COL    = "zip3_bank_concentration"

if done_p1:
    print("이미 적용됨 — 건너뜀")
else:
    for p in (CENSUS_CACHE, FDIC_CACHE):
        if not os.path.exists(p):
            raise FileNotFoundError(
                f"{os.path.basename(p)} 이 없습니다. build_part1_meta.py 를 "
                f"네트워크 되는 환경에서 먼저 실행해 캐시를 만들어 주세요."
            )

    census = pd.read_csv(CENSUS_CACHE, dtype={"zip3": str})
    fdic   = pd.read_csv(FDIC_CACHE,   dtype={"zip3": str})

    # LC zip_code('100xx') 앞 3자리. 결측은 NaN 유지(문자열 'nan' 방지)
    zc = df["zip_code"].astype(str).str.strip()
    df["zip3"] = zc.str[:3].where(zc.str.match(r"^\d{3}"), other=np.nan)

    df = df.merge(census[["zip3"] + CENSUS_COLS], on="zip3", how="left")
    n_census_na = int(df["zip3_median_income"].isna().sum())
    print(f"Census 매칭 실패: {n_census_na:,}건 ({n_census_na / len(df) * 100:.3f}%)")
    print("  (군사우편 APO/FPO·사서함 전용 대역 등 지리적 실체가 없는 권역)")
    for c in CENSUS_COLS:
        df[c] = pd.to_numeric(df[c], errors="coerce")
        df[c] = df[c].fillna(df[c].median())

    df = df.merge(fdic[["zip3", BANK_COL]], on="zip3", how="left")
    n_bank_na = int(df[BANK_COL].isna().sum())
    print(f"FDIC 매칭 실패:   {n_bank_na:,}건 ({n_bank_na / len(df) * 100:.3f}%)")
    print("  (은행 지점이 실제로 없는 권역이라 Census 보다 실패율이 높음)")
    df[BANK_COL] = pd.to_numeric(df[BANK_COL], errors="coerce")
    df[BANK_COL] = df[BANK_COL].fillna(df[BANK_COL].median())

    df = df.drop(columns=["zip3"])
    del census, fdic
    print("→ zip3 외부변수 4개 병합 완료 (income_to_zip3_median 은 Part3 에서 계산)")


# ─────────────────────────────────────────────────────────
# 2. Part 2 — 대출 자체 조건
# ─────────────────────────────────────────────────────────
section("2. Part 2 — 대출 자체 조건")

if done_p2:
    print("이미 적용됨 — 건너뜀")
else:
    # loan_amnt: 결측 0%, 왜도 0.78, 500~40,000 로 상한이 제도적으로 막혀 있어 그대로 사용
    print(f"[loan_amnt] 결측 {df['loan_amnt'].isna().sum():,}건, "
          f"왜도 {df['loan_amnt'].skew():.3f} → 변환 없이 사용")

    # ── term: 이진 인코딩, 컬럼명 유지 ──
    # 원본이 ' 36 months' 처럼 앞 공백이 있어 문자열 비교 대신 숫자만 추출한다.
    print("[term] 이진 인코딩 (36개월=0, 60개월=1)")
    term_months = pd.to_numeric(
        df["term"].astype(str).str.strip().str.extract(r"(\d+)")[0], errors="coerce"
    )
    unexpected = set(term_months.dropna().unique()) - {36, 60}
    if unexpected:
        raise ValueError(f"예상치 못한 term 값: {unexpected}")
    if term_months.isna().any():
        raise ValueError(f"term 변환 실패 {term_months.isna().sum():,}건")
    df["term"] = (term_months == 60).astype("int8")
    print(f"  60개월 비율 {df['term'].mean() * 100:.2f}%")

    # ── purpose: 희소범주 통합 후 원-핫 ──
    print("[purpose] 희소범주 통합 후 원-핫")
    purpose_clean = df["purpose"].astype(str).str.strip().str.lower()

    vc = purpose_clean.value_counts()
    merged = [c for c in vc.index if c not in PURPOSE_KEEP and c != "nan"]
    n_merged = int(vc[merged].sum()) if merged else 0
    print(f"  단독 유지 {len(PURPOSE_KEEP)}개: {PURPOSE_KEEP}")
    print(f"  '{PURPOSE_FALLBACK}' 로 통합된 범주 {len(merged)}개, "
          f"{n_merged:,}건 ({n_merged / len(df) * 100:.2f}%)")
    for c in merged:
        print(f"    {c:20s} {int(vc[c]):>9,}")

    # 유지 목록에 없는 값은 모두 fallback 으로
    purpose_clean = purpose_clean.where(purpose_clean.isin(PURPOSE_KEEP), PURPOSE_FALLBACK)

    # 범주를 명시적으로 고정해야 train/val/test 분할 후에도 컬럼 구성이 어긋나지 않는다
    dummies = pd.get_dummies(
        pd.Categorical(purpose_clean, categories=PURPOSE_KEEP),
        prefix="purpose", dtype="int8",
    )
    dummies.index = df.index
    df = pd.concat([df, dummies], axis=1)
    df = df.drop(columns=["purpose"])
    print(f"  원-핫 {len(PURPOSE_COLS)}개 생성: {PURPOSE_COLS}")

    del term_months, purpose_clean, dummies


# ─────────────────────────────────────────────────────────
# 3. Part 3 — 차주 신용 프로필
# ─────────────────────────────────────────────────────────
section("3. Part 3 — 차주 신용 프로필")

if done_p3:
    print("이미 적용됨 — 건너뜀")
else:
    # ── 3-1. annual_inc: 하한 결측화 + 상위 윈저라이징 (아직 로그는 취하지 않음) ──
    print("[1] annual_inc — 이상치 정제")
    print(f"  변환 전 왜도 {df['annual_inc'].skew():.1f}, "
          f"범위 {df['annual_inc'].min():,.0f} ~ {df['annual_inc'].max():,.0f}")

    # 연소득 0 이하는 구조적으로 불가능한 값이다. 대출이 승인된 건에 소득 0 이
    # 기록될 수 없으므로 입력 오류로 보고 결측 처리한다. 이 값들을 남겨두면
    # log1p(0)=0 이 되어 왼쪽 꼬리가 생기고, 로그변환 후 왜도가 오히려
    # -4.9 까지 악화된다(실측).
    n_zero = int((df["annual_inc"] <= ANNUAL_INC_FLOOR).sum())
    df.loc[df["annual_inc"] <= ANNUAL_INC_FLOOR, "annual_inc"] = np.nan
    print(f"  하한: {ANNUAL_INC_FLOOR:,} 이하 {n_zero:,}건 "
          f"({n_zero / len(df) * 100:.3f}%)을 결측 처리")

    # 소수의 극단값(최대 1.1억 달러)이 분포 전체를 왜곡하므로 먼저 상한을 씌운다.
    # 로그를 먼저 취하면 극단값이 이미 압축돼 윈저라이징 효과가 희석된다.
    inc_cap = df["annual_inc"].quantile(ANNUAL_INC_CLIP_Q)
    n_clipped = int((df["annual_inc"] > inc_cap).sum())
    df["annual_inc"] = df["annual_inc"].clip(upper=inc_cap)
    print(f"  상한: 상위 {(1 - ANNUAL_INC_CLIP_Q) * 100:.1f}% 윈저라이징 "
          f"({inc_cap:,.0f} 초과 {n_clipped:,}건)")

    inc_median = df["annual_inc"].median()
    n_inc_na = int(df["annual_inc"].isna().sum())
    df["annual_inc"] = df["annual_inc"].fillna(inc_median)
    print(f"  결측 {n_inc_na:,}건을 중앙값 {inc_median:,.0f} 로 대체 "
          f"(정제 후 왜도 {df['annual_inc'].skew():.2f})")

    # ── 3-2. fico_avg ──
    print("[2] fico_avg")
    df["fico_avg"] = (df["fico_range_low"] + df["fico_range_high"]) / 2
    print(f"  fico_range_low·high 평균 (결측 {df['fico_avg'].isna().sum():,}건, "
          f"범위 {df['fico_avg'].min():.0f}~{df['fico_avg'].max():.0f})")
    df = df.drop(columns=["fico_range_low", "fico_range_high"])
    print("  원본 fico_range_low, fico_range_high 삭제")

    # ── 3-3. dti ──
    print("[3] dti")
    n_neg = int((df["dti"] < 0).sum())
    n_sent = int((df["dti"] >= DTI_SENTINEL).sum())
    n_over = int((df["dti"] > DTI_CAP).sum())
    n_na0 = int(df["dti"].isna().sum())
    print(f"  음수 {n_neg:,}건 | {DTI_SENTINEL} 이상 센티넬 {n_sent:,}건 | "
          f"{DTI_CAP} 초과 {n_over:,}건 | 원 결측 {n_na0:,}건")

    # 999는 '측정 불가'를 뜻하는 코드값이므로 실수치로 두면 평균·분위수가 오염된다.
    # 음수도 정의상 불가능하므로 함께 결측 처리한 뒤 중앙값으로 대체한다.
    df.loc[df["dti"] >= DTI_SENTINEL, "dti"] = np.nan
    df.loc[df["dti"] < 0, "dti"] = np.nan
    df["dti"] = df["dti"].clip(upper=DTI_CAP)
    dti_median = df["dti"].median()
    n_imputed = int(df["dti"].isna().sum())
    df["dti"] = df["dti"].fillna(dti_median)
    print(f"  → 상한 {DTI_CAP} 클리핑, 결측 {n_imputed:,}건을 중앙값 {dti_median:.2f} 로 대체")

    # ── 3-4. emp_length: 순서형 인코딩, 컬럼명 유지 ──
    print("[4] emp_length — 순서형 인코딩 (컬럼명 유지)")
    EMP_MAP = {
        "< 1 year": 0, "1 year": 1, "2 years": 2, "3 years": 3, "4 years": 4,
        "5 years": 5, "6 years": 6, "7 years": 7, "8 years": 8, "9 years": 9,
        "10+ years": 10,
    }
    emp_clean = df["emp_length"].astype(str).str.strip()
    emp_ord = emp_clean.map(EMP_MAP)

    bad_emp = set(emp_clean[emp_ord.isna() & (emp_clean != "nan")].unique())
    if bad_emp:
        print(f"  [주의] 매핑되지 않은 emp_length 값: {bad_emp}")

    # 결측은 '무직'을 뜻하므로 별도 더미로 표시한다. 순서형 값은 0(근속 0년)으로
    # 채우되, 더미가 있으므로 모델은 '무직'과 '1년 미만 재직'을 구분할 수 있다.
    df["emp_length_missing"] = emp_ord.isna().astype("int8")
    df["emp_length"] = emp_ord.fillna(0).astype("int8")
    print(f"  0~10 인코딩 | 무직(결측) {df['emp_length_missing'].sum():,}건 "
          f"({df['emp_length_missing'].mean() * 100:.2f}%)")

    # ── 3-5. home_ownership: 희소범주 통합 후 원-핫 ──
    print("[5] home_ownership — 희소범주 통합 후 원-핫")
    home_clean = df["home_ownership"].astype(str).str.strip().str.upper()
    hvc = home_clean.value_counts()
    home_merged = [c for c in hvc.index if c not in HOME_KEEP and c != "NAN"]
    n_home_merged = int(hvc[home_merged].sum()) if home_merged else 0
    print(f"  '{HOME_FALLBACK}' 로 통합: {home_merged} "
          f"{n_home_merged:,}건 ({n_home_merged / len(df) * 100:.3f}%)")

    home_clean = home_clean.where(home_clean.isin(HOME_KEEP), HOME_FALLBACK)
    home_dummies = pd.get_dummies(
        pd.Categorical(home_clean, categories=HOME_KEEP),
        prefix="home_ownership", dtype="int8",
    )
    home_dummies.index = df.index
    df = pd.concat([df, home_dummies], axis=1)
    df = df.drop(columns=["home_ownership"])
    print(f"  원-핫 {len(HOME_COLS)}개 생성: {HOME_COLS}")

    # ── 3-6. application_type: 이진 변환, 컬럼명 유지 ──
    print("[6] application_type — 이진 변환 (컬럼명 유지)")
    app_clean = df["application_type"].astype(str).str.strip().str.lower()
    df["application_type"] = app_clean.str.startswith("joint").astype("int8")
    print(f"  Individual=0 / Joint=1 | Joint 비율 "
          f"{df['application_type'].mean() * 100:.2f}% "
          f"({df['application_type'].sum():,}건)")

    del emp_clean, emp_ord, home_clean, home_dummies, app_clean

    # ── 3-7. income_to_zip3_median ──
    # 반드시 annual_inc 에 log1p 를 적용하기 '전'에 계산해야 한다.
    # 로그 적용 후에 계산하면 분자가 로그 스케일이 되어 '지역 중위소득 대비 배수'
    # 라는 변수의 의미가 무너진다.
    print("[7] income_to_zip3_median")
    df["income_to_zip3_median"] = (
        df["annual_inc"] / df["zip3_median_income"].replace(0, np.nan)
    )
    print(f"  중앙값 {df['income_to_zip3_median'].median():.3f}, "
          f"왜도 {df['income_to_zip3_median'].skew():.2f}")

    # ── 3-8. annual_inc log1p 적용 (제자리) ──
    # income_to_zip3_median 계산이 끝난 뒤 마지막에 수행한다.
    print("[8] annual_inc — log1p 적용 (컬럼명 유지)")
    df["annual_inc"] = np.log1p(df["annual_inc"])
    print(f"  log1p 후 왜도 {df['annual_inc'].skew():.3f} "
          f"(범위 {df['annual_inc'].min():.3f}~{df['annual_inc'].max():.3f})")
    print("  ※ annual_inc 는 이제 로그 스케일 값이다. 원 단위 해석 시 expm1 필요.")


