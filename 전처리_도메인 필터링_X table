# 2. Group A — annual_inc / dti / revol_bal 통합
# ─────────────────────────────────────────────────────────
section("2. Group A — 공동신청 값 통합 (제자리)")
 
# ── 2-1. annual_inc ──
# 현재 annual_inc 는 Part3 에서 log1p 된 상태다. 원 단위인 annual_inc_joint 와
# 합치려면 먼저 되돌려야 한다.
print("[annual_inc]")
print(f"  병합 전(로그 스케일) 범위 {df['annual_inc'].min():.3f} ~ {df['annual_inc'].max():.3f}")
inc_raw = np.expm1(df["annual_inc"])                       # 로그 → 원 단위 복원
n_use_joint = int((df["annual_inc_joint"].notna()).sum())
inc_comb = df["annual_inc_joint"].fillna(inc_raw)          # joint 있으면 joint, 없으면 개인
print(f"  joint 값 사용 {n_use_joint:,}건, 개인 값 사용 {len(df) - n_use_joint:,}건")
 
n_zero = int((inc_comb <= ANNUAL_INC_FLOOR).sum())
inc_comb = inc_comb.mask(inc_comb <= ANNUAL_INC_FLOOR)     # 소득 0 이하는 입력 오류
cap = inc_comb.quantile(ANNUAL_INC_CLIP_Q)
n_clip = int((inc_comb > cap).sum())
inc_comb = inc_comb.clip(upper=cap)
med = inc_comb.median()
n_na = int(inc_comb.isna().sum())
inc_comb = inc_comb.fillna(med)
df["annual_inc"] = np.log1p(inc_comb)                      # 다시 log1p
print(f"  하한 {n_zero:,}건 / 상한 {cap:,.0f} 초과 {n_clip:,}건 / 결측 {n_na:,}건 중앙값 대체")
print(f"  → 재변환 후 범위 {df['annual_inc'].min():.3f} ~ {df['annual_inc'].max():.3f}, "
      f"왜도 {df['annual_inc'].skew():.3f}")
 
# ── 2-2. dti ──
# dti 는 스케일 변환이 없어 역변환이 필요 없다. 다만 Part3 과 같은 정제를 다시 적용한다.
print("\n[dti]")
n_use_joint = int(df["dti_joint"].notna().sum())
dti_comb = df["dti_joint"].fillna(df["dti"])
print(f"  joint 값 사용 {n_use_joint:,}건, 개인 값 사용 {len(df) - n_use_joint:,}건")
n_sent = int((dti_comb >= DTI_SENTINEL).sum())
n_neg = int((dti_comb < 0).sum())
n_over = int((dti_comb > DTI_CAP).sum())
dti_comb = dti_comb.mask(dti_comb >= DTI_SENTINEL).mask(dti_comb < 0)
dti_comb = dti_comb.clip(upper=DTI_CAP)
dmed = dti_comb.median()
n_na = int(dti_comb.isna().sum())
df["dti"] = dti_comb.fillna(dmed)
print(f"  센티넬 {n_sent:,}건 / 음수 {n_neg:,}건 / {DTI_CAP} 초과 {n_over:,}건 "
      f"/ 결측 {n_na:,}건 중앙값 {dmed:.2f} 대체")
print(f"  → 범위 {df['dti'].min():.2f} ~ {df['dti'].max():.2f}")
 
# ── 2-3. revol_bal ──
# 현재 revol_bal 은 Part4 에서 Yeo-Johnson(λ=0.246) 된 상태다.
# docx 기준 revol_bal 은 log1p 가 과교정되어 YJ 를 채택했으므로, 통합 후에도 YJ 를 유지한다.
print("\n[revol_bal]")
print(f"  병합 전(YJ 스케일) 범위 {df['revol_bal'].min():.3f} ~ {df['revol_bal'].max():.3f}")
bal_raw = yj_inverse(df["revol_bal"].to_numpy(dtype=float), REVOL_BAL_YJ_LAM)
bal_raw = pd.Series(bal_raw, index=df.index).clip(lower=0)
n_use_joint = int(df["revol_bal_joint"].notna().sum())
bal_comb = df["revol_bal_joint"].fillna(bal_raw).clip(lower=0)
print(f"  joint 값 사용 {n_use_joint:,}건, 개인 값 사용 {len(df) - n_use_joint:,}건")
n_na = int(bal_comb.isna().sum())
if n_na:
    bal_comb = bal_comb.fillna(bal_comb.median())
    print(f"  결측 {n_na:,}건 중앙값 대체")
df["revol_bal"] = yj_forward(bal_comb.to_numpy(dtype=float), REVOL_BAL_YJ_LAM)
print(f"  → 재변환 후 범위 {df['revol_bal'].min():.3f} ~ {df['revol_bal'].max():.3f}, "
      f"왜도 {df['revol_bal'].skew():.3f}")
 
 
