def find_data_dir(filename="X_table_raw.csv", max_up=5):
    try:
        start = os.path.dirname(os.path.abspath(__file__))
    except NameError:
        start = os.getcwd()
    d = start
    for _ in range(max_up):
        if os.path.exists(os.path.join(d, filename)):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    raise FileNotFoundError(f"'{filename}' 을 '{start}' 및 상위에서 찾지 못했습니다.")
 
 
def section(t):
    print("\n" + "=" * 64)
    print(t)
    print("=" * 64, flush=True)
 
 
def yj_forward(x, lam):
    """Yeo-Johnson (x >= 0, lam != 0 구간). revol_bal 은 항상 0 이상이다."""
    return ((x + 1.0) ** lam - 1.0) / lam
 
 
def yj_inverse(y, lam):
    """yj_forward 의 역함수."""
    return (y * lam + 1.0) ** (1.0 / lam) - 1.0
 
 
