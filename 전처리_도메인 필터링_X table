# 1. Census ACS → zip3 집계
# ─────────────────────────────────────────────────────────
def fetch_census_zip3():
    """ZCTA 단위 ACS 5년 자료를 받아 zip3 단위로 인구가중 집계."""
    import requests

    base = f"https://api.census.gov/data/{CENSUS_YEAR}/acs/acs5"
    variables = {
        "B19013_001E": "median_income",       # 중위 가구소득
        "B25077_001E": "median_home_value",   # 중위 주택가치
        "B01003_001E": "population",          # 총 인구 (가중치용)
        "B19051_001E": "hh_total",            # 전체 가구 수
        "B19051_002E": "hh_with_earnings",    # 근로소득 있는 가구
        "B19051_003E": "hh_no_earnings",      # 근로소득 없는 가구
    }

    log("[변수 유효성 확인]")
    valid = []
    for code, name in variables.items():
        r = requests.get(
            base,
            params={"get": f"NAME,{code}", "for": "state:01", "key": CENSUS_API_KEY},
            timeout=60,
        )
        ok = r.status_code == 200
        log(f"  {code} ({name}): {'OK' if ok else 'FAIL — ' + r.text[:80]}")
        if ok:
            valid.append(code)

    if not valid:
        raise RuntimeError("Census 변수를 하나도 받지 못했습니다. API 키를 확인하세요.")

    log("\n[전체 ZCTA 수집]")
    r = requests.get(
        base,
        params={
            "get": "NAME," + ",".join(valid),
            "for": "zip code tabulation area:*",
            "key": CENSUS_API_KEY,
        },
        timeout=180,
    )
    r.raise_for_status()
    data = r.json()
    acs = pd.DataFrame(data[1:], columns=data[0])
    log(f"  수집 완료: {acs.shape}")

    acs = acs.rename(columns={"zip code tabulation area": "zcta", **variables})

    num_cols = [v for v in variables.values() if v in acs.columns]
    acs[num_cols] = acs[num_cols].apply(pd.to_numeric, errors="coerce")
    # Census 결측코드(-666666666 등)를 NaN 으로
    acs[num_cols] = acs[num_cols].mask(acs[num_cols] < 0)

    acs["zip3"] = acs["zcta"].astype(str).str.zfill(5).str[:3]

    # 검산: hh_total ≈ with + no
    need = {"hh_total", "hh_with_earnings", "hh_no_earnings"}
    if need.issubset(acs.columns):
        chk = acs.dropna(subset=list(need))
        diff = chk["hh_total"] - (chk["hh_with_earnings"] + chk["hh_no_earnings"])
        log(f"  [검산] 가구 수 불일치: {(diff.abs() > 1).sum()}건 / {len(chk):,}건")

    # ── zip3 인구가중 집계 (벡터화) ──
    def weighted_by_pop(value_col):
        """population 을 가중치로 한 zip3별 가중평균."""
        d = acs[["zip3", value_col, "population"]].dropna()
        num = (d[value_col] * d["population"]).groupby(d["zip3"]).sum()
        den = d["population"].groupby(d["zip3"]).sum()
        return (num / den.replace(0, np.nan)).rename(f"zip3_{value_col}")

    parts = [
        weighted_by_pop("median_income"),
        weighted_by_pop("median_home_value"),
    ]

    hh = acs.groupby("zip3")[["hh_no_earnings", "hh_total"]].sum()
    parts.append(
        (hh["hh_no_earnings"] / hh["hh_total"].replace(0, np.nan))
        .rename("zip3_no_earnings_ratio")
    )
    parts.append(acs.groupby("zip3")["population"].sum().rename("zip3_population"))
    parts.append(acs.groupby("zip3").size().rename("zcta_count"))

    zip3_table = pd.concat(parts, axis=1).reset_index()
    log(f"\n  [zip3 집계 완료] {len(zip3_table):,}개 권역")
    return zip3_table


# ─────────────────────────────────────────────────────────
# 2. FDIC SOD → zip3 은행 집중도
# ─────────────────────────────────────────────────────────
def fetch_fdic_zip3():
    """FDIC Summary of Deposits 를 받아 zip3 단위 CR5 / HHI / 은행수 계산."""
    import requests

    url = "https://banks.data.fdic.gov/api/sod"
    rows, offset = [], 0
    log(f"[FDIC SOD {FDIC_YEAR} 수집]")
    while True:
        r = requests.get(
            url,
            params={
                "filters": f"YEAR:{FDIC_YEAR}",
                "fields": "CERT,ZIPBR,DEPSUMBR,STALPBR",
                "limit": 10000,
                "offset": offset,
                "format": "json",
            },
            timeout=180,
        )
        r.raise_for_status()
        batch = r.json().get("data", [])
        if not batch:
            break
        rows.extend([x["data"] for x in batch])
        offset += 10000
        log(f"  {len(rows):,}건 수집...")

    sod = pd.DataFrame(rows)
    log(f"  수집 완료: {sod.shape}")

    # ── 정제 ──
    sod["DEPSUMBR"] = pd.to_numeric(sod["DEPSUMBR"], errors="coerce")
    sod["ZIPBR"] = sod["ZIPBR"].astype(str).str.extract(r"(\d+)")[0].str.zfill(5)
    sod["zip3"] = sod["ZIPBR"].str[:3]

    before = len(sod)
    sod = sod.dropna(subset=["CERT", "zip3", "DEPSUMBR"])
    sod = sod[sod["DEPSUMBR"] >= 0]
    log(f"  정제: {before:,} → {len(sod):,}행  "
        f"(zip3 {sod['zip3'].nunique():,}개 / 은행 {sod['CERT'].nunique():,}개)")

    # ── 집중도 계산 (벡터화) ──
    # 한 은행이 같은 권역에 여러 지점을 두면 합산
    bank_dep = sod.groupby(["zip3", "CERT"], as_index=False)["DEPSUMBR"].sum()

    total = bank_dep.groupby("zip3")["DEPSUMBR"].sum().rename("zip3_total_deposits")

    # CR5: 권역별 예금 상위 5개 은행의 점유율 합
    ranked = bank_dep.sort_values(["zip3", "DEPSUMBR"], ascending=[True, False])
    ranked["rank"] = ranked.groupby("zip3").cumcount()
    top5 = ranked[ranked["rank"] < 5].groupby("zip3")["DEPSUMBR"].sum()

    # HHI: 모든 은행 점유율의 제곱합
    share = bank_dep["DEPSUMBR"] / bank_dep["zip3"].map(total).replace(0, np.nan)
    hhi = (share ** 2).groupby(bank_dep["zip3"]).sum().rename("zip3_bank_hhi")

    conc = pd.concat(
        [
            (top5 / total.replace(0, np.nan)).rename("zip3_bank_concentration"),
            hhi,
            bank_dep.groupby("zip3")["CERT"].nunique().rename("zip3_bank_count"),
            total,
        ],
        axis=1,
    ).reset_index()

    log(f"  [집계 완료] {len(conc):,}개 zip3")

    # CR5 포화 진단 (은행이 적으면 CR5가 자동으로 1.0이 되는 문제)
    sat_ratio = (conc["zip3_bank_concentration"] >= 0.999).mean() * 100
    log(f"  CR5 포화(=1.0) 비율: {sat_ratio:.1f}%  "
        f"{'-> 20% 미만이므로 CR5 주지표 사용 가능' if sat_ratio < 20 else '-> 20% 초과, HHI 주지표 검토'}")

    return conc


# ─────────────────────────────────────────────────────────
# 캐시 래퍼
# ─────────────────────────────────────────────────────────
def load_or_fetch(cache_path, fetch_fn, label):
    if os.path.exists(cache_path):
        log(f"[캐시 사용] {os.path.basename(cache_path)}")
        return pd.read_csv(cache_path, dtype={"zip3": str})

    log(f"[캐시 없음] {label} API 수집을 시작합니다.")
    try:
        table = fetch_fn()
    except Exception as e:
        log(f"\n!! {label} 수집 실패: {type(e).__name__}: {e}")
        log(f"!! 네트워크가 되는 환경(Colab 등)에서 실행하거나,")
        log(f"!! 조원에게 받은 {os.path.basename(cache_path)} 을 다음 위치에 두고 다시 실행하세요:")
        log(f"!!   {cache_path}")
        sys.exit(1)

    table.to_csv(cache_path, index=False)
    log(f"[캐시 저장] {os.path.basename(cache_path)}")
    return table


# ─────────────────────────────────────────────────────────
# 3. 병합 + 파생변수
# ─────────────────────────────────────────────────────────
def main():
    section("0. X 테이블 로드")
    x = pd.read_csv(X_IN_PATH, dtype={"zip_code": str})
    n_before = len(x)
    log(f"입력: {x.shape[0]:,}행 × {x.shape[1]}열")

    # LC zip_code('100xx')에서 앞 3자리 추출. 결측은 NaN 유지(문자열 'nan' 방지)
    zc = x["zip_code"].astype(str).str.strip()
    x["zip3"] = zc.str[:3].where(zc.str.match(r"^\d{3}"), other=np.nan)
    log(f"zip3 고유값: {x['zip3'].nunique():,}개 / zip3 결측 {x['zip3'].isna().sum():,}건")

    census = load_or_fetch(CENSUS_CACHE, fetch_census_zip3, "Census ACS")
    fdic   = load_or_fetch(FDIC_CACHE,   fetch_fdic_zip3,   "FDIC SOD")

    # ── 3-1. Census 병합 ──
    section("1. Census 병합")
    census_cols = ["zip3_median_income", "zip3_median_home_value", "zip3_no_earnings_ratio"]
    x = x.merge(census[["zip3"] + census_cols], on="zip3", how="left")

    n_census_na = int(x["zip3_median_income"].isna().sum())
    log(f"매칭 실패: {n_census_na:,}건 ({n_census_na / len(x) * 100:.3f}%)")
    log("  (군사우편 APO/FPO·사서함 전용 대역 등 지리적 실체가 없는 권역)")

    # 표본 비중이 미미하므로 전체 중앙값으로 대체
    for c in census_cols:
        x[c] = pd.to_numeric(x[c], errors="coerce")
        x[c] = x[c].fillna(x[c].median())

    # ── 3-2. FDIC 병합 ──
    section("2. FDIC 병합")
    # 최종 채택 지표는 CR5 하나. HHI·은행수는 X 테이블에 넣지 않는다.
    bank_col = "zip3_bank_concentration"
    x = x.merge(fdic[["zip3", bank_col]], on="zip3", how="left")

    # Census 와 실패 권역이 다르므로 건수를 따로 집계한다
    n_bank_na = int(x[bank_col].isna().sum())
    log(f"매칭 실패: {n_bank_na:,}건 ({n_bank_na / len(x) * 100:.3f}%)")
    log("  (은행 지점이 실제로 없는 권역이라 Census 보다 실패율이 높음)")

    x[bank_col] = pd.to_numeric(x[bank_col], errors="coerce")
    x[bank_col] = x[bank_col].fillna(x[bank_col].median())

    # ── 3-3. 파생변수 ──
    section("3. 파생변수 생성")
    # income_to_zip3_median: 차주 소득이 지역 중위소득 대비 몇 배인가
    # (절대소득과 달리 지역 물가·소득수준을 통제한 상대적 위치를 포착)
    denom = x["zip3_median_income"].replace(0, np.nan)
    x["income_to_zip3_median"] = x["annual_inc"] / denom
    log(f"income_to_zip3_median 생성 "
        f"(결측 {x['income_to_zip3_median'].isna().sum():,}건, "
        f"중앙값 {x['income_to_zip3_median'].median():.3f})")
    log("  ※ annual_inc 기준. 공동신청자 소득 통합(annual_inc_joint)은")
    log("     이후 '변수별 정제' 단계에서 반영 후 재계산 필요.")

    x = x.drop(columns=["zip3"])   # 병합 키는 제거 (zip_code 는 보존)

    # ── 3-4. 검증 ──
    section("4. 검증")
    # 식별자/메타정보 그룹 최종 채택 변수 5개
    new_cols = census_cols + [bank_col, "income_to_zip3_median"]

    ok = True
    if len(x) != n_before:
        log(f"[실패] 행 수 변동: {n_before:,} -> {len(x):,} (left join 이므로 유지돼야 정상)")
        ok = False
    else:
        log(f"[통과] 행 수 유지: {len(x):,}행")

    resid = int(x[census_cols + [bank_col]].isna().sum().sum())
    if resid:
        log(f"[실패] 외부변수 잔여 결측 {resid}건")
        ok = False
    else:
        log("[통과] 외부변수 잔여 결측 0건")

    # 지역변수이므로 같은 zip3 는 같은 값을 가져야 정상
    chk = x.groupby(x["zip_code"].astype(str).str[:3])["zip3_median_income"].nunique()
    if (chk > 1).sum():
        log(f"[실패] zip3당 값이 2개 이상인 경우 {(chk > 1).sum()}건")
        ok = False
    else:
        log("[통과] zip3별 지역변수 값 일관성 확인")

    # 의도한 5개만 붙었는지 확인 (HHI·은행수·플래그가 새어 들어오지 않았는지)
    leaked = [c for c in x.columns if c.startswith("zip3_") and c not in new_cols]
    if leaked:
        log(f"[실패] 최종 채택 외 zip3 변수가 남아 있음: {leaked}")
        ok = False
    else:
        log("[통과] 식별자 그룹 최종 5개 외 잔여 컬럼 없음")

    log("\n[신규 변수 왜도]")
    for c in new_cols:
        log(f"  {c:28s}: {x[c].skew():.2f}")
    log("  ※ 로그/YJ 변환은 모델별로 필요 여부가 달라 전처리 마지막 단계에서 일괄 적용")

    log("\n[외부변수 간 상관]")
    log(x[new_cols].corr().round(3).to_string())

    log("\n[결측 대체 내역 — 리포트 기재용]")
    log(f"  Census 계열 중앙값 대체: {n_census_na:,}건 ({n_census_na / len(x) * 100:.3f}%)")
    log(f"  FDIC CR5 중앙값 대체:    {n_bank_na:,}건 ({n_bank_na / len(x) * 100:.3f}%)")

    x.to_csv(X_OUT_PATH, index=False)
    section("완료")
    log(f"출력: {x.shape[0]:,}행 × {x.shape[1]}열")
    log(f"추가된 컬럼 {len(new_cols)}개: {new_cols}")
    log(f"저장: {X_OUT_PATH}")
    if not ok:
        log("\n!! 검증 실패 항목이 있습니다. 위 로그를 확인하세요.")
        sys.exit(1)


if __name__ == "__main__":
    main()


