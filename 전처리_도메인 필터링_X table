def _find_data_dir(filename="X_table_raw.csv", max_up=5):
    """
    스크립트가 git repo 서브폴더 등 데이터 파일과 다른 위치에 있어도
    동작하도록, 현재 위치에서 상위로 올라가며 filename 을 찾는다.
    VS Code Jupyter 셀(# %%)로 실행할 때는 __file__ 이 정의되지 않거나
    스크립트가 저장된 위치를 가리키므로, 이 탐색이 필요하다.
    """
    try:
        start = os.path.dirname(os.path.abspath(__file__))
    except NameError:
        start = os.getcwd()

    d = start
    for _ in range(max_up):
        if os.path.exists(os.path.join(d, filename)):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent

    raise FileNotFoundError(
        f"'{filename}' 을 '{start}' 및 상위 {max_up}단계 폴더에서 찾지 못했습니다.\n"
        f"BASE_DIR 을 아래처럼 직접 지정해 주세요:\n"
        f'    BASE_DIR = "/Users/hanyunju/Documents/통계_데이터사이언스_Lending Club 과제"'
    )


