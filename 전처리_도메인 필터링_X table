    (df["open_acc"].eq(0),
     ["num_op_rev_tl", "num_actv_rev_tl", "num_bc_sats", "num_actv_bc_tl"], "open_acc=0"),
    # 관측자료에서 0 일치율 99.66~99.89% 확인됨
    (df["revol_bal"].eq(0),
     ["num_actv_rev_tl", "num_actv_bc_tl"], "revol_bal=0"),
    # 관측자료 43,860건에서 예외 없이 100% 일치
    (df["acc_open_past_24mths"].eq(0),
     ["num_tl_op_past_12m"], "acc_open_past_24mths=0"),
    # 관측자료 12,277건에서 99.94%가 0
    (df["total_bc_limit"].eq(0),
     ["num_actv_bc_tl"], "total_bc_limit=0"),
]
n_zero_cells = 0
for cond, cols, name in zero_rules:
    cond = cond.fillna(False)
    for c in cols:
        m = cond & df[c].isna()
        k = int(m.sum())
        if k:
            df.loc[m, c] = 0.0
            n_zero_cells += k
print(f"0 규칙으로 대치된 셀: {n_zero_cells:,}개")

# D-3. mths_since_recent_inq — 조회 조건 대치 후 log1p (제자리)
# inq_last_6mths / inq_last_12m / inq_fi 를 교차 확인해 마지막 조회 시점 구간을 판정한다.
miss = df["mths_since_recent_inq"].isna()
m_0_6  = miss & df["inq_last_6mths"].gt(0)                       # 0~6개월 구간 → 중간값 3
m_6_12 = miss & df["inq_last_6mths"].eq(0) & df["inq_last_12m"].gt(0)   # 6~12개월 → 중간값 9
m_none = (miss & df["inq_last_6mths"].eq(0)
          & (df["inq_last_12m"].isna() | df["inq_last_12m"].eq(0))
          & (df["inq_fi"].isna() | df["inq_fi"].eq(0)))          # 조회 없음 → sentinel

sentinel = float(df["mths_since_recent_inq"].max()) + 1
df.loc[m_0_6,  "mths_since_recent_inq"] = 3.0
df.loc[m_6_12, "mths_since_recent_inq"] = 9.0
df.loc[m_none, "mths_since_recent_inq"] = sentinel

n_amb = int(df["mths_since_recent_inq"].isna().sum())
print(f"\nmths_since_recent_inq 결측 {int(miss.sum()):,}건 분해")
print(f"  0~6개월(→3):   {int(m_0_6.sum()):,}")
print(f"  6~12개월(→9):  {int(m_6_12.sum()):,}")
print(f"  조회없음(→{sentinel:g}): {int(m_none.sum()):,}")
print(f"  확인 불가:      {n_amb:,}  → sentinel 로 통일 (결측 0 방침)")
if n_amb:
    df["mths_since_recent_inq"] = df["mths_since_recent_inq"].fillna(sentinel)

# 부도율과의 관계가 초기에 급하고 이후 완만해지는 패턴을 반영해 로그 변환한다.
df["mths_since_recent_inq"] = np.log1p(df["mths_since_recent_inq"])
print(f"  log1p 적용 (왜도 {df['mths_since_recent_inq'].skew():.3f})")

# D-4. 잔여 결측 → 계층 제약 공동 hot-deck
# 한 행의 세부 계좌 변수를 같은 donor 에서 가져와 변수 간 결합구조를 보존한다.
recipient_mask = df[ACCOUNT_DETAIL_COLS].isna().any(axis=1)
n_recipient = int(recipient_mask.sum())
print(f"\nhot-deck 대상 행: {n_recipient:,}건")

if n_recipient:
    # donor 는 완전 관측 + 비음수 정수 + 모든 hard constraint 만족
    donor_mask = df[ACCOUNT_DETAIL_COLS].notna().all(axis=1)
    donor_mask &= df[ACCOUNT_DETAIL_COLS].ge(0).all(axis=1)
    dv = df[ACCOUNT_DETAIL_COLS].to_numpy(dtype=float)
    donor_mask &= pd.Series(
        np.isclose(dv, np.rint(dv), rtol=0, atol=1e-9, equal_nan=False).all(axis=1),
        index=df.index)
    del dv
    for parent, child in HIERARCHY_PAIRS:
        donor_mask &= df[parent].ge(df[child])
    for bnd, cols in UPPER_BOUND_COLUMNS.items():
        for c in cols:
            donor_mask &= df[c].le(df[bnd])
    donor_mask = donor_mask.fillna(False)
    print(f"donor 후보: {int(donor_mask.sum()):,}건")

    # 매칭 변수 — 차주 특성이 유사한 행을 찾는다.
    # annual_inc 는 Part3 에서 이미 log1p 됨. fico_range_low 대신 fico_avg 사용.
    match_numeric = ["open_acc", "total_acc", "revol_bal", "revol_util",
                     "inq_last_6mths", "mths_since_recent_inq",
                     "annual_inc", "dti", "fico_avg", "loan_amnt"]
    mf = df[match_numeric].astype(float).copy()
    # 큰 양의 왜도를 줄여 거리 계산이 금액 변수에 지배되지 않게 한다.
    for c in ["revol_bal", "loan_amnt"]:
        mf[c] = np.log1p(mf[c].clip(lower=0))
    home_cols = [c for c in df.columns if c.startswith("home_ownership_")]
    mf = pd.concat([mf, df[home_cols].astype(float)], axis=1)

    # 이 중앙값은 donor 검색용 거리 계산에만 쓰고 최종 변수 대치에는 쓰지 않는다.
    mf = mf.fillna(mf.loc[donor_mask].median())
    mu = mf.loc[donor_mask].mean()
    sd = mf.loc[donor_mask].std().replace(0, 1)
    ms = ((mf - mu) / sd)
    ms[["open_acc", "total_acc"]] *= 2.0    # 계좌 총계가 비슷한 donor 를 우선
    del mf

    donor_pos = np.flatnonzero(donor_mask.to_numpy())
    recip_pos = np.flatnonzero(recipient_mask.to_numpy())
    donor_mat = np.ascontiguousarray(ms.to_numpy(dtype=np.float32)[donor_pos])
    recip_mat = np.ascontiguousarray(ms.to_numpy(dtype=np.float32)[recip_pos])
    del ms

    print(f"KD트리 구축 중... ({donor_mat.shape[0]:,} × {donor_mat.shape[1]}차원)")
    tree = cKDTree(donor_mat, compact_nodes=True, balanced_tree=True)
    k = min(HOTDECK_K, len(donor_mat))
    print(f"donor {k}개 탐색 중... (수 분 소요)")
    _, nb_pos = tree.query(recip_mat, k=k, workers=-1)
    if k == 1:
        nb_pos = nb_pos[:, None]
    del donor_mat, recip_mat, tree

    donor_detail = df.iloc[donor_pos][ACCOUNT_DETAIL_COLS].to_numpy(dtype=float)
    recip_detail = df.iloc[recip_pos][ACCOUNT_DETAIL_COLS].to_numpy(dtype=float)
    recip_na = np.isnan(recip_detail)
    valid = np.ones(nb_pos.shape, dtype=bool)
    cpos = {c: i for i, c in enumerate(ACCOUNT_DETAIL_COLS)}

    # 수여자의 '관측된' 값과 충돌하는 donor 후보를 제외한다.
    for parent, child in HIERARCHY_PAIRS:
        pp, cp = cpos[parent], cpos[child]
        cand_p = donor_detail[nb_pos, pp]
        cand_c = donor_detail[nb_pos, cp]
        a = recip_na[:, pp] & ~recip_na[:, cp]
        b = recip_na[:, cp] & ~recip_na[:, pp]
        valid[a] &= cand_p[a] >= recip_detail[a, cp, None]
        valid[b] &= cand_c[b] <= recip_detail[b, pp, None]

    for bnd, cols in UPPER_BOUND_COLUMNS.items():
        rb = df.iloc[recip_pos][bnd].to_numpy(dtype=float)
        for c in cols:
            bp = cpos[c]
            need = recip_na[:, bp]
            valid[need] &= donor_detail[nb_pos, bp][need] <= rb[need, None]

    has_valid = valid.any(axis=1)
    rank = np.argmax(valid, axis=1)
    rank[~has_valid] = 0
    chosen = donor_pos[nb_pos[np.arange(len(recip_pos)), rank]]
    print(f"논리적으로 유효한 donor 를 찾은 행: {int(has_valid.sum()):,} / {len(recip_pos):,}")

    sel = df.iloc[chosen][ACCOUNT_DETAIL_COLS].to_numpy(dtype=float)
    imputed = recip_detail.copy()
    imputed[recip_na] = sel[recip_na]
    df.loc[df.index[recip_pos], ACCOUNT_DETAIL_COLS] = imputed
    del donor_detail, recip_detail, sel, imputed, nb_pos, valid

    # 후보 부재 등 예외에 대비해, 실제로 대치된 셀만 조정해 제약을 보장한다.
    #
    # 제약들이 서로 얽혀 있어 한 번만 훑으면 부족하다.
    # 예: num_bc_tl >= num_bc_sats 를 맞추려고 num_bc_tl 을 올리면
    #     앞서 통과했던 num_rev_accts >= num_bc_tl 이 다시 깨진다.
    # 더 이상 위반이 없을 때까지 반복한다(원본 관측값은 모든 제약을 만족하므로 수렴).
    n_repair = 0
    for sweep in range(20):
        changed = 0
        for bnd, cols in UPPER_BOUND_COLUMNS.items():
            for c in cols:
                m = df[c].gt(df[bnd]) & detail_missing_before[c]
                k = int(m.sum())
                if k:
                    df.loc[m, c] = df.loc[m, bnd]
                    changed += k
        for parent, child in HIERARCHY_PAIRS:
            m = df[parent].lt(df[child]) & detail_missing_before[parent]
            k = int(m.sum())
            if k:
                df.loc[m, parent] = df.loc[m, child]
                changed += k
            m = df[parent].lt(df[child]) & detail_missing_before[child]
            k = int(m.sum())
            if k:
                df.loc[m, child] = df.loc[m, parent]
                changed += k
        n_repair += changed
        if changed == 0:
            break
    else:
        print("  [주의] 20회 반복 후에도 제약 위반이 남았습니다. 검증 결과를 확인하세요.")
    print(f"제약 위반 보정: {n_repair:,}셀 ({sweep + 1}회 반복 후 수렴)")

    # 대치된 계좌 수를 비음수 정수로 확정
    for c in ACCOUNT_DETAIL_COLS:
        m = detail_missing_before[c]
        df.loc[m, c] = np.rint(df.loc[m, c].clip(lower=0))

# hot-deck 으로도 남는 결측이 있으면 중앙값으로 마무리 (결측 0 방침)
left = int(df[ACCOUNT_DETAIL_COLS].isna().sum().sum())
if left:
    print(f"잔여 결측 {left}셀 → 중앙값 대체")
    for c in ACCOUNT_DETAIL_COLS:
        df[c] = df[c].fillna(df[c].median())


