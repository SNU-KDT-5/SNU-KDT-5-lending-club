]
ENCODED_VARS = PURPOSE_COLS + HOME_COLS
FLAG_VARS    = ["emp_length_missing"]

derived_present = [c for c in DERIVED_VARS if c in df.columns]
encoded_new     = [c for c in ENCODED_VARS if c in new_cols]
flag_new        = [c for c in FLAG_VARS if c in new_cols]

unclassified = [c for c in new_cols
                if c not in DERIVED_VARS + ENCODED_VARS + FLAG_VARS]
if unclassified:
    print(f"[주의] 분류되지 않은 신규 컬럼: {unclassified}")

print("신규 컬럼 성격별 내역")
print(f"  파생변수    {len(derived_present):>2}개  (원본에 없던 새 정보 → 파일로 저장)")
print(f"  인코딩 결과 {len(encoded_new):>2}개  (범주형을 원-핫으로 펼친 것)")
print(f"  결측 플래그 {len(flag_new):>2}개")
print("  ※ annual_inc·term·dti·emp_length·application_type 은 이름을 유지한 채"
      " 제자리에서 정제되어 신규 컬럼이 아님")

